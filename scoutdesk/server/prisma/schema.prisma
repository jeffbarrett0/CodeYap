generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Relative to this file. Swap for another provider/URL when moving off dev.
  url      = "file:./scoutdesk.db"
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  role      String    @default("analyst") // admin | analyst | viewer
  color     String    @default("#a3e635")
  createdAt DateTime  @default(now())
  clips     Clip[]
  comments  Comment[]
}

model Team {
  id          String   @id @default(cuid())
  name        String
  shortName   String
  color       String   @default("#3b82f6")
  isOwn       Boolean  @default(false)
  country     String?
  formation   String   @default("4-3-3")
  notes       String   @default("")
  createdAt   DateTime @default(now())
  players     Player[]
  homeMatches Match[]  @relation("HomeTeam")
  awayMatches Match[]  @relation("AwayTeam")
  clips       Clip[]
}

model Player {
  id          String   @id @default(cuid())
  name        String
  photoUrl    String?
  jersey      Int?
  positions   Json // string[]
  foot        String? // left | right | both
  heightCm    Int?
  age         Int?
  nationality String?
  notes       String   @default("")
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  clips       Clip[]
}

model Match {
  id          String   @id @default(cuid())
  date        DateTime
  competition String   @default("")
  venue       String?
  homeTeamId  String
  awayTeamId  String
  homeTeam    Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam    Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore   Int?
  awayScore   Int?
  tagStatus   String   @default("untagged") // untagged | in_progress | complete
  lineups     Json // { home: string[], away: string[] } player ids
  notes       String   @default("")
  createdAt   DateTime @default(now())
  videos      Video[]
  clips       Clip[]
}

model Video {
  id            String   @id @default(cuid())
  title         String
  originalName  String
  filePath      String // relative to the storage dir
  mimeType      String   @default("video/mp4")
  sizeBytes     BigInt   @default(0)
  durationSec   Float    @default(0)
  fps           Float    @default(25)
  width         Int      @default(0)
  height        Int      @default(0)
  status        String   @default("processing") // processing | ready | failed
  error         String?
  thumbnailPath String?
  angle         String   @default("Main")
  syncOffset    Float    @default(0) // seconds, relative to the match's main angle
  tags          Json // string[]
  matchId       String?
  match         Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  clips         Clip[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  color     String
  sortOrder Int       @default(0)
  tagTypes  TagType[]
}

model TagType {
  id             String   @id @default(cuid())
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String
  hotkey         String? // e.g. "s", "shift+x", "1"
  defaultOutcome String   @default("neutral") // success | fail | neutral
  sortOrder      Int      @default(0)
  clips          Clip[]
}

model Clip {
  id            String         @id @default(cuid())
  matchId       String
  match         Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  videoId       String?
  video         Video?         @relation(fields: [videoId], references: [id], onDelete: SetNull)
  tagTypeId     String
  tagType       TagType        @relation(fields: [tagTypeId], references: [id])
  startSec      Float
  endSec        Float
  timeSec       Float // the moment the tag was pressed
  playerId      String?
  player        Player?        @relation(fields: [playerId], references: [id], onDelete: SetNull)
  teamId        String?
  team          Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  jersey        Int?
  outcome       String         @default("neutral") // success | fail | neutral
  zone          String? // "3x3:5" | "6x4:11"
  x             Float? // pitch coords 0..100, left→right = own goal → opponent goal
  y             Float?
  endX          Float?
  endY          Float?
  notes         String         @default("")
  labels        Json // string[]
  createdById   String?
  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  comments      Comment[]
  playlistItems PlaylistItem[]

  @@index([matchId])
  @@index([playerId])
}

model Playlist {
  id          String         @id @default(cuid())
  title       String
  description String         @default("")
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       PlaylistItem[]
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  clipId     String
  clip       Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  position   Int
  title      String? // overrides the auto title (tag · player)
  transition String   @default("cut") // transition INTO this item: cut | fade

  @@index([playlistId, position])
}

model ExportJob {
  id          String    @id @default(cuid())
  kind        String // clip | playlist
  refId       String
  label       String
  status      String    @default("queued") // queued | running | done | failed
  progress    Float     @default(0)
  error       String?
  filePath    String?
  fileName    String?
  sizeBytes   BigInt    @default(0)
  options     Json
  createdById String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?
}

model ShareLink {
  id           String    @id @default(cuid())
  token        String    @unique
  kind         String // playlist | match
  refId        String
  label        String
  passwordHash String?
  expiresAt    DateTime?
  revoked      Boolean   @default(false)
  createdById  String?
  createdAt    DateTime  @default(now())
  views        Int       @default(0)
}

model Comment {
  id        String    @id @default(cuid())
  clipId    String
  clip      Clip      @relation(fields: [clipId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("Thread")
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())

  @@index([clipId])
}

model Snapshot {
  id          String   @id @default(cuid())
  matchId     String?
  videoId     String?
  clipId      String?
  playerId    String?
  timeSec     Float    @default(0)
  caption     String   @default("")
  filePath    String
  createdById String?
  createdAt   DateTime @default(now())
}
