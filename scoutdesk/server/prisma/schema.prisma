generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Relative to this file. Swap for another provider/URL when moving off dev.
  url      = "file:./scoutdesk.db"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("analyst") // admin | analyst | viewer
  color     String   @default("#a3e635")
  createdAt DateTime @default(now())
  clips     Clip[]
}

model Team {
  id          String   @id @default(cuid())
  name        String
  shortName   String
  color       String   @default("#3b82f6")
  isOwn       Boolean  @default(false)
  country     String?
  formation   String   @default("4-3-3")
  notes       String   @default("")
  createdAt   DateTime @default(now())
  players     Player[]
  homeMatches Match[]  @relation("HomeTeam")
  awayMatches Match[]  @relation("AwayTeam")
  clips       Clip[]
}

model Player {
  id          String   @id @default(cuid())
  name        String
  photoUrl    String?
  jersey      Int?
  positions   Json      // string[]
  foot        String? // left | right | both
  heightCm    Int?
  age         Int?
  nationality String?
  notes       String   @default("")
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  clips       Clip[]
}

model Match {
  id          String   @id @default(cuid())
  date        DateTime
  competition String   @default("")
  venue       String?
  homeTeamId  String
  awayTeamId  String
  homeTeam    Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam    Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore   Int?
  awayScore   Int?
  tagStatus   String   @default("untagged") // untagged | in_progress | complete
  lineups     Json      // { home: string[], away: string[] } player ids
  notes       String   @default("")
  createdAt   DateTime @default(now())
  videos      Video[]
  clips       Clip[]
}

model Video {
  id            String   @id @default(cuid())
  title         String
  originalName  String
  filePath      String // relative to the storage dir
  mimeType      String   @default("video/mp4")
  sizeBytes     BigInt   @default(0)
  durationSec   Float    @default(0)
  fps           Float    @default(25)
  width         Int      @default(0)
  height        Int      @default(0)
  status        String   @default("processing") // processing | ready | failed
  error         String?
  thumbnailPath String?
  angle         String   @default("Main")
  syncOffset    Float    @default(0) // seconds, relative to the match's main angle
  tags          Json      // string[]
  matchId       String?
  match         Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  clips         Clip[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  color     String
  sortOrder Int       @default(0)
  tagTypes  TagType[]
}

model TagType {
  id             String   @id @default(cuid())
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String
  hotkey         String? // e.g. "s", "shift+x", "1"
  defaultOutcome String   @default("neutral") // success | fail | neutral
  sortOrder      Int      @default(0)
  clips          Clip[]
}

model Clip {
  id          String   @id @default(cuid())
  matchId     String
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  videoId     String?
  video       Video?   @relation(fields: [videoId], references: [id], onDelete: SetNull)
  tagTypeId   String
  tagType     TagType  @relation(fields: [tagTypeId], references: [id])
  startSec    Float
  endSec      Float
  timeSec     Float // the moment the tag was pressed
  playerId    String?
  player      Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  jersey      Int?
  outcome     String   @default("neutral") // success | fail | neutral
  zone        String? // "3x3:5" | "6x4:11"
  x           Float? // pitch coords 0..100, left→right = own goal → opponent goal
  y           Float?
  endX        Float?
  endY        Float?
  notes       String   @default("")
  labels      Json      // string[]
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([matchId])
  @@index([playerId])
}
